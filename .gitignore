import pandas as pd
import numpy as np
import seaborn as sns
import matplotlib.pyplot as plt
import gdown
from sklearn.preprocessing import MinMaxScaler
from sklearn.cluster import KMeans
from sklearn.ensemble import RandomForestRegressor

ID_IDH = '14EgXDCiEaovX4sfHEfLi9HCThsap0r71'
ID_HERITAGE = '1K6FmTsRaDGd85pw976RZRQlELV-2Rhrf'

gdown.download(f'https://drive.google.com/uc?id={ID_IDH}', 'idh.xlsx', quiet=False)
gdown.download(f'https://drive.google.com/uc?id={ID_HERITAGE}', 'heritage.csv', quiet=False)

features_12 = [
    'Property Rights', 'Judicial Effectiveness', 'Government Integrity',
    'Tax Burden', 'Government Spending', 'Fiscal Health',
    'Business Freedom', 'Labor Freedom', 'Monetary Freedom',
    'Trade Freedom', 'Investment Freedom', 'Financial Freedom'
]

df_idh = pd.read_excel('idh.xlsx', header=5)[['Country', 'Value']].dropna()
df_idh['Value'] = pd.to_numeric(df_idh['Value'], errors='coerce')

df_econ = pd.read_csv('heritage.csv', skiprows=3, sep=',', engine='python')
df_econ = df_econ[['Country', 'Overall Score'] + features_12].dropna()

for col in features_12 + ['Overall Score']:
    df_econ[col] = pd.to_numeric(df_econ[col], errors='coerce')

df_final = df_econ.merge(df_idh, on="Country", how="inner").dropna()

X = df_final[features_12]
y = df_final['Value']
rf = RandomForestRegressor(n_estimators=100, random_state=42)
rf.fit(X, y)

ranking = pd.Series(rf.feature_importances_, index=features_12).sort_values(ascending=False)

scaler = MinMaxScaler()
df_norm = scaler.fit_transform(df_final[features_12 + ['Value']])
df_final['Cluster'] = KMeans(n_clusters=5, random_state=42, n_init=10).fit_predict(df_norm)

print("\nRANKING DE IMPORTÂNCIA:")
print(ranking.map(lambda x: f"{x:.2%}"))

plt.figure(figsize=(10,6))
sns.barplot(x=ranking.values, y=ranking.index, palette='viridis')
plt.title('Influência das Variáveis Econômicas no IDH')
plt.show()
