import pandas as pd
import requests
from sklearn.ensemble import RandomForestRegressor
from sklearn.preprocessing import StandardScaler
from sklearn.model_selection import train_test_split

#Baixando dados do heritage e IDH

def baixar_dados():
    try:
        url_idh = 'https://drive.google.com/uc?export=download&id=14EgXDCiEaovX4sfHEfLi9HCThsap0r71'
        r = requests.get(url_idh)
        with open('idh.xlsx', 'wb') as f:
            f.write(r.content)

        url_heritage = 'https://drive.google.com/uc?export=download&id=1K6FmTsRaDGd85pw976RZRQlELV-2Rhrf'
        r = requests.get(url_heritage)
        with open('heritage.csv', 'wb') as f:
            f.write(r.content)
            
    except:
        print("Erro ao baixar os dados. Verifique a conexão.")



# carregando e limpando os dados
def carregar_dados():
    
    df_idh = pd.read_excel('idh.xlsx', header=5)[['Country', 'Value']].dropna()
    
    df_idh['Value'] = pd.to_numeric(df_idh['Value'], errors='coerce')

    df_heritage = pd.read_csv('heritage.csv', skiprows=3, engine='python')
    
    df_heritage = df_heritage.dropna()
    
    df_heritage = df_heritage.drop(columns=['Index Year', 'Overall Score'])

    df_final = pd.merge(df_heritage, df_idh, on='Country', how='inner').dropna()
    return df_final

#Fazendo a correlação relação entre liberdade econômica e IDH
def correlacao(df):
   
    df_corr = df.drop(columns=['Country']).corr()['Value'].drop('Value').sort_values(ascending=False)
    return df_corr

# descobrindo as importâncias com Random Forest
def random_forest(df):
    X = df.drop(columns=['Country', 'Value'])
    y = df['Value']

    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X)

    X_train, X_test, y_train, y_test = train_test_split(X_scaled, y, test_size=0.2, random_state=42)

    rf = RandomForestRegressor(n_estimators=100, random_state=42)
    rf.fit(X_train, y_train)
    
    numeros_importancia = rf.feature_importances_

    tabela_importancia = pd.Series(data=numeros_importancia, index=X.columns)

    tabela_ordenada = tabela_importancia.sort_values(ascending=False)
    
    return tabela_ordenada


#E executando as funções
def main():
    baixar_dados()
    df = carregar_dados()
    
    print("\n" + "="*60)
    print("CORRELAÇÃO COM IDH")
    print("="*60)
    print(correlacao(df))
    print("="*60)
    
    print("\n" + "="*60)
    print("IMPORTÂNCIA DAS CARACTERÍSTICAS (RANDOM FOREST)")
    print("="*60)
    print(random_forest(df))
    print("="*60)

main()
