import pandas as pd
import requests
from sklearn.ensemble import RandomForestRegressor
from sklearn.preprocessing import StandardScaler
from sklearn.model_selection import train_test_split

# 1. Baixar dados
print("Baixando dados...")
url_idh = 'https://drive.google.com/uc?export=download&id=14EgXDCiEaovX4sfHEfLi9HCThsap0r71'
response = requests.get(url_idh, allow_redirects=True)
open('idh.xlsx', 'wb').write(response.content)

url_heritage = 'https://drive.google.com/uc?export=download&id=1K6FmTsRaDGd85pw976RZRQlELV-2Rhrf'
response = requests.get(url_heritage, allow_redirects=True)
open('heritage.csv', 'wb').write(response.content)

#Carregando dados
df_idh = pd.read_excel('idh.xlsx', header=5)[['Country', 'Value']].dropna()
df_idh['Value'] = pd.to_numeric(df_idh['Value'], errors='coerce')

colunas = ['Country', 'Property Rights', 'Judicial Effectiveness', 'Government Integrity',
           'Tax Burden', 'Government Spending', 'Fiscal Health', 'Business Freedom',
           'Labor Freedom', 'Monetary Freedom', 'Trade Freedom', 'Investment Freedom',
           'Financial Freedom']
df_heritage = pd.read_csv('heritage.csv', skiprows=3, engine='python')[colunas].dropna()
df_final = pd.merge(df_heritage, df_idh, on='Country', how='inner').dropna()

#Preparar dados para os modelos
X = df_final.drop(columns=['Country', 'Value'])
y = df_final['Value']


#MÉTODO 1: CORRELAÇÃO

print("\n" + "="*60)
print("CORRELAÇÃO COM IDH")
print("="*60)
correlacoes = df_final.drop(columns=['Country']).corr()['Value'].drop('Value').sort_values(ascending=False)
print(correlacoes)
print("="*60)

#MÉTODO 2: RANDOM FOREST

print("\n" + "="*60)
print("IMPORTÂNCIA DAS CARACTERÍSTICAS (RANDOM FOREST)")
print("="*60)

#Normalizando
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

# Dividindo em treino e teste
X_train, X_test, y_train, y_test = train_test_split(X_scaled, y, test_size=0.2, random_state=42)

# Rodar Random Forest
rf = RandomForestRegressor(n_estimators=100, random_state=42)
rf.fit(X_train, y_train)

importancias = pd.Series(rf.feature_importances_, index=X.columns).sort_values(ascending=False)
print(importancias)
print("="*60)
